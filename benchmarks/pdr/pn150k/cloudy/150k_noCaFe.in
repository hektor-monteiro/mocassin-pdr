set punch prefix "150k"
Blackbody 150000.000000 linear
luminosity (total) = 36.583 log
radius = 16.000
sphere
hden = 3.000 log
filling factor = 1.0
abundances GASS no grains
element calcium off
element iron off
distance = 1000.0 parsecs linear
Cosmic rays background
Database H2 limit -10
stop temperature linear 40K
print line faint -8
print last
iterate to converge
Save lines, intensity, column, emergent, ".lines"
print line flux earth
print line precision 6
grains ISM graphite 1 linear
element scale factor silicon 0.01
element scale factor magnesium 0.01
element scale factor calcium 0.01
element scale factor aluminium 0.01
iterate
save PDR ".pdr"
save last radius ".rad"
save last continuum ".cont"
save last physical conditions ".phy"
save last overview ".ovr"
save last heating ".heat"
save last cooling ".cool"
save last optical depth ".opd"
save last element hydrogen ".ele_H"
save last element helium ".ele_He"
save last element carbon ".ele_C"
save last element nitrogen ".ele_N"
save last element oxygen ".ele_O"
save last element argon ".ele_Ar"
save last element neon ".ele_Ne"
save last element sulphur ".ele_S"
save last element chlorin ".ele_Cl"
save last element silicon ".ele_Si"
save last species densities ".dens"
