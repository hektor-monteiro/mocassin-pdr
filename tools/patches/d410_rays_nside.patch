       !            computeAVradial built independently). -1 unless nStars == 1.
       !   nUnset   sites whose first leg was never computed (pdrColH2 < 0)
       !-----------------------------------------------------------------
+      !-----------------------------------------------------------------
+      ! D-410 diagnostic (L-53): the HEALPix nside = pdrRayNside pixel centres
+      ! in RING order, constructed directly. Rings 1 .. nside-1 and
+      ! 3 nside+1 .. 4 nside-1 are the polar caps (4 i pixels at
+      ! phi = (j - 1/2) pi / (2 i)); rings nside .. 3 nside the belt (4 nside
+      ! pixels, every other ring shifted by half a pixel). At nside = 1 this
+      ! is the twelve traceDiffuseSites and traceLineRays built before, in
+      ! the same order and to the last bit.
+      !-----------------------------------------------------------------
+      subroutine rayDirections(vx, vy, vz)
+        implicit none
+        double precision, intent(out) :: vx(0:nRayDir-1), vy(0:nRayDir-1), vz(0:nRayDir-1)
+        integer          :: ir, ip, j, k, nr, ns, s
+        double precision :: zz, ph, sr
+
+        ns = pdrRayNside
+        k  = 0
+        do ir = 1, 4*ns - 1
+           if (ir < ns) then
+              ip = ir;          nr = 4*ip; s = 1
+              zz =  dble(3*ns*ns - ip*ip)/dble(3*ns*ns)
+           else if (ir <= 3*ns) then
+              ip = ns;          nr = 4*ns; s = mod(ir - ns + 1, 2)
+              zz =  dble(4*ns - 2*ir)/dble(3*ns)
+           else
+              ip = 4*ns - ir;   nr = 4*ip; s = 1
+              zz = -dble(3*ns*ns - ip*ip)/dble(3*ns*ns)
+           end if
+           sr = sqrt(max(1.d0 - zz*zz, 0.d0))
+           do j = 1, nr
+              ! the old twelve's expression, so that nside = 1 is them to the last bit
+              ph = (dble(j-1)+0.5d0*dble(s))*pi*0.5d0
+              if (ip > 1) ph = ph/dble(ip)
+              vx(k) = sr*cos(ph); vy(k) = sr*sin(ph); vz(k) = zz
+              k = k + 1
+           end do
+        end do
+        if (k /= nRayDir) then
+           print*, "! rayDirections: ", k, " directions for nside ", ns
+           stop
+        end if
+      end subroutine rayDirections
+
