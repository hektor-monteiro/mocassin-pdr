# Prerequisites
*.d
# ...but not the chemical networks, which share the extension (D-352): they
# were ignored by the line above and never versioned.
!dataPDR/*.d

# Compiled Object files
*.slo
*.lo
*.o
*.obj

# Precompiled Headers
*.gch
*.pch

# Compiled Dynamic libraries
*.so
*.dylib
*.dll

# Fortran module files
*.mod
*.smod

# Compiled Static libraries
*.lai
*.la
*.a
*.lib

# Executables
*.exe
*.out
*.app

mocassinWarm

mocassin

mocassinOutput

mocassinPlot

# per-entry build snapshots (mocassin.d131, mocassin.1d, ...), D-274
/mocassin.*

# vendored 3D-PDR object files
source/pdr/*.o
pdrSmokeTest
.pdrflag

# Run directories: symlinked fixtures and multi-MB logs. The [D196] blocks
# extracted from them are in the DEVLOG; the raw logs are not worth versioning.
runs/
tools/__pycache__/
h2Test
h2Slab
